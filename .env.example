# Copy to .env and change every secret before running.
NODE_ENV=development
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://waxo:change-me@postgres:5432/waxo
REDIS_URL=redis://redis:6379
JWT_ACCESS_SECRET=change-me-long-random
JWT_REFRESH_SECRET=change-me-other-long-random
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me-too
S3_BUCKET_PRIVATE=waxo-private
S3_BUCKET_PUBLIC=waxo-public
STREAM_MIN_SECONDS=30
SIGNED_URL_TTL_SECONDS=300
APP_URL=http://localhost

# --- Email & SMTP (Real delivery & password resets) ---
# Supports any SMTP provider (Resend, Amazon SES, Brevo, Mailgun, Postmark, etc.).
# For local testing, Mailpit runs at http://localhost:8025 (web UI) and port 1025 (SMTP).
# If using Docker compose, set SMTP_HOST=mailpit and SMTP_PORT=1025.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
MAIL_FROM="WaXo Music <noreply@waxo.ug>"

# --- Google Authentication (Sign in with Google) ---
# Create an OAuth 2.0 Web Client ID in Google Cloud Console:
# Set Authorized JavaScript origins to your app domain (e.g. http://localhost:5173, https://waxo.ug)
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# --- Media / uploads ---
# URL the BROWSER uses to reach object storage (signed URLs). Dev: MinIO on localhost. Prod: your S3/CDN domain.
S3_PUBLIC_ENDPOINT=http://localhost:9000
# Base URL for public artwork (public bucket). Prod: CDN URL.
PUBLIC_MEDIA_URL=http://localhost:9000/waxo-public
MAX_AUDIO_MB=150
MAX_AUDIO_MINUTES=30
AUDIO_WORKER=true
AUDIO_CONCURRENCY=2
IP_HASH_SALT=change-me-random
# Optional malware scanning: run `docker compose --profile scan up` and set:
# CLAMAV_HOST=clamav
# CLAMAV_PORT=3310

# --- Stream counting / abuse limits ---
STREAM_REPLAY_COOLDOWN_SECONDS=180
STREAM_MAX_PER_IP_HOUR=60
STREAM_MAX_STARTS_PER_IP_HOUR=300
